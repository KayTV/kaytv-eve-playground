# Copy this file to .env.local and fill in real values yourself —
# .env.local is gitignored and Claude will never read or write it directly.

# Vercel OIDC token, used by the eve agent's model routing (Vercel AI
# Gateway) and by the Claude Code harness's sandbox (@ai-sdk/sandbox-vercel).
# Populated automatically by `vercel link` + `vercel env pull` when the
# project is linked to a Vercel project/team.
VERCEL_OIDC_TOKEN=your-vercel-oidc-token

# Alternative to VERCEL_OIDC_TOKEN for routing the eve agent's model calls
# through the Vercel AI Gateway. Only one of AI_GATEWAY_API_KEY /
# VERCEL_OIDC_TOKEN is required.
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# Required by app/api/harness/chat/agent.ts. The Claude Code harness is
# configured with auth: "direct", so it needs a direct Anthropic API key
# rather than routing through the Vercel AI Gateway. Get one at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
